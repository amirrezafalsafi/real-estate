# Environment Configuration

# Database Connection (SQLite by default for development)
DATABASE_URL="file:./dev.db"

# To switch to PostgreSQL:
# 1. In `prisma/schema.prisma`, change datasource provider from "sqlite" to "postgresql"
# 2. Uncomment the PostgreSQL URL below and replace credentials:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/real_estate_db?schema=public"
# 3. Run: npx prisma migrate dev --name init_postgres

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
