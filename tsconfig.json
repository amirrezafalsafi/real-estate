{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "#actions/*": ["./src/actions/*"],
      "#api/*": ["./src/api/*"],
      "#app/*": ["./src/app/*"],
      "#components/*": ["./src/components/*"],
      "#configs/*": ["./src/configs/*"],
      "#constants/*": ["./src/constants/*"],
      "#enums/*": ["./src/enums/*"],
      "#hooks/*": ["./src/hooks/*"],
      "#libraries/*": ["./src/libraries/*"],
      "#public/*": ["./public/*"],
      "#stores/*": ["./src/stores/*"],
      "#styles/*": ["./src/styles/*"],
      "#types/*": ["./src/types/*"],
      "#utilities/*": ["./src/utilities/*"],
      "@/*": ["./src/*", "./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
